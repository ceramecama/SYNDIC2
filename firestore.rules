rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════
    //  SYNDIC 1 - Firestore Security Rules
    // ════════════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    // ──── Users collection ────
    match /users/{userId} {
      allow read, write: if isAuth();
    }

    // ──── Chat messages ────
    match /syndic_chat/{messageId} {
      allow read, write: if isAuth();
    }

    // ──── Syndic main data (apartments, expenses, etc.) ────
    match /syndic_data/{docId} {
      allow read, write: if isAuth();
    }

    // ──── Announcements ────
    match /syndic_announcements/{annId} {
      allow read, write: if isAuth();
    }

    // ──── Announcement images ────
    match /syndic_announcements_images/{imgId} {
      allow read, write: if isAuth();
    }

    // ──── Receipts (expense images) ────
    match /syndic_receipts/{receiptId} {
      allow read, write: if isAuth();
    }

  }
}
