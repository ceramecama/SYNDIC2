rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════
    //  قواعد الأمان لتطبيق السنديك (SYNDIC 1)
    // ════════════════════════════════════════════════════════════
    //  أي مستخدم مسجل الدخول (Authenticated) له حق القراءة والكتابة.
    //  التحكم في الأدوار والواجهات (Admin / Resident) يتم عبر التطبيق.
    // ════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
